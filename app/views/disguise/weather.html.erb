<div class="text-slate-100" data-controller="calculator">
  <header class="flex items-center justify-between pt-2 pb-6">
    <div>
      <p class="text-sm text-slate-400">My Location</p>
      <h1 class="text-xl font-semibold">Nairobi</h1>
    </div>
    <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-lg" aria-hidden="true">⚙</span>
  </header>

  <button type="button" data-action="calculator#tapTemperature" class="block w-full text-left cursor-default" aria-label="Current temperature">
    <div class="flex items-start gap-2">
      <span class="text-[104px] leading-none font-light tracking-tight">24°</span>
      <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="mt-4 opacity-80">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/>
      </svg>
    </div>
    <p class="text-lg text-slate-300 mt-1">Sunny with afternoon clouds</p>
    <p class="text-sm text-slate-400 mt-0.5">H:27° L:17° · feels like 25°</p>
  </button>

  <section class="mt-7 rounded-3xl bg-white/10 backdrop-blur p-4" aria-label="Hourly forecast">
    <p class="text-xs uppercase tracking-wider text-slate-400 mb-3">Today</p>
    <div class="flex justify-between text-center">
      <% [["Now", "24°"], ["13:00", "26°"], ["14:00", "27°"], ["15:00", "26°"], ["16:00", "24°"]].each do |hour, temp| %>
        <div class="flex flex-col items-center gap-1.5">
          <span class="text-xs text-slate-400"><%= hour %></span>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 3v1.5M12 19.5V21M3 12h1.5M19.5 12H21M5.6 5.6l1 1m10.8 10.8 1 1M5.6 18.4l1-1m10.8-10.8 1-1"/><circle cx="12" cy="12" r="3.5"/></svg>
          <span class="text-sm font-semibold"><%= temp %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mt-4 rounded-3xl bg-white/10 backdrop-blur p-4" aria-label="Five day forecast">
    <% days = Date.current.strftime("%a") %>
    <% [days, "Tue", "Wed", "Thu", "Fri"].zip([[17, 27], [16, 25], [18, 28], [17, 24], [15, 23]], %w[clear rain cloud sun cloud]).each do |day, lo_hi, kind| %>
      <div class="flex items-center justify-between py-2.5 border-b border-white/5 last:border-0">
        <span class="w-14 text-sm <%= "font-bold" if day == days %>"><%= day %></span>
        <span class="opacity-70" aria-hidden="true">
          <% if kind == "rain" %>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 16.6A4.5 4.5 0 0 0 17.5 8h-1.3A7 7 0 1 0 5 15.7"/><path d="M8 19v2m4-1v2m4-3v2"/></svg>
          <% elsif kind == "cloud" %>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M17.5 19a4.5 4.5 0 1 0-.9-8.9 6 6 0 1 0-10.8 4.6"/></svg>
          <% else %>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2m0 14v2M3 12h2m14 0h2"/></svg>
          <% end %>
        </span>
        <span class="text-sm text-slate-300 w-16 text-right"><%= lo_hi[0] %>°</span>
        <span class="relative w-16 h-1 rounded-full bg-gradient-to-r from-sky-300 to-amber-200">
          <span class="absolute inset-y-0 left-0 rounded-full bg-white/90" style="width: <%= ((lo_hi[0] - 14.0) / 15 * 100).to_i %>%"></span>
        </span>
        <span class="text-sm font-semibold w-8 text-right"><%= lo_hi[1] %>°</span>
      </div>
    <% end %>
  </section>

  <section class="grid grid-cols-3 gap-3 mt-4 mb-2" aria-label="Conditions detail">
    <% [["Humidity", "58%"], ["Wind", "12 km/h"], ["UV index", "6 High"]].each do |label, value| %>
      <div class="rounded-2xl bg-white/10 p-3">
        <p class="text-[11px] uppercase tracking-wide text-slate-400"><%= label %></p>
        <p class="text-lg font-semibold mt-1"><%= value %></p>
      </div>
    <% end %>
  </section>

  <div data-calculator-target="pad" class="screen-hidden fixed inset-x-0 bottom-0 z-30 mx-auto max-w-[480px] rounded-t-3xl bg-slate-900/95 backdrop-blur px-6 pt-6 pb-8 shadow-2xl">
    <p class="text-center text-slate-300 text-sm">Enter passcode</p>
    <div class="flex justify-center gap-3 mt-4" aria-hidden="true">
      <span class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-colors" data-dot></span>
      <span class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-colors" data-dot></span>
      <span class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-colors" data-dot></span>
      <span class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-colors" data-dot></span>
    </div>
    <div class="grid grid-cols-3 gap-3 mt-5">
      <% ["1","2","3","4","5","6","7","8","9","","0","⌫"].each do |d| %>
        <% if d == "" %>
          <span></span>
        <% elsif d == "⌫" %>
          <button type="button" data-action="calculator#clearCode"
                  class="min-h-[56px] rounded-full bg-white/10 text-slate-200 text-xl active:bg-white/20">⌫</button>
        <% else %>
          <button type="button" data-digit="<%= d %>" data-action="calculator#digit"
                  class="min-h-[56px] rounded-full bg-white/10 text-slate-50 text-2xl font-light active:bg-white/25"><%= d %></button>
        <% end %>
      <% end %>
    </div>
    <p class="sr-only">Passcode entry</p>
  </div>

  <p class="text-center text-slate-500 text-xs mt-6 mb-2">Weather data refreshed just now</p>
</div>
