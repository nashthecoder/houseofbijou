<!DOCTYPE html>
<html lang="en">
  <head>
    <title>House of Bijou</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Calculator">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= asset_path "favicon.png" %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path "favicon.png" %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
    <style>html { font-size: <%= settings.text_scale || 18 %>px; }</style>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= "high-contrast" if settings.high_contrast %>">
    <div class="app-shell">
      <div class="mobile-frame">
        <main class="real-screen view-enter relative">
          <%= yield %>
        </main>

        <%= render "shared/toast" %>
      </div>
    </div>
  </body>
</html>
